# Copy this file to .env.local and fill in your Supabase project values.
# Leave them empty to use this browser only. The app will say so on screen.
# Find these in Supabase: Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signs the login cookie. Use a long random string. A sign-in lasts 3 months.
AUTH_SECRET=

# Server-only connection for accounts and sessions. Use the Supabase pooler
# string from Project Settings → Database. Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=

# Then run the SQL in supabase/schema.sql in the Supabase SQL editor.
